generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"; url = env("DATABASE_URL") }
enum Role { ADMIN TEACHER STUDENT }
enum AccountStatus { PENDING ACTIVE REJECTED DISABLED }
enum AttendanceStatus { PRESENT ABSENT LATE }
model User { id String @id @default(cuid()) username String @unique email String? @unique passwordHash String role Role status AccountStatus @default(ACTIVE) student Student? teacher Teacher? resetTokens PasswordResetToken[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model Student { id String @id @default(cuid()) studentNumber String @unique fullName String email String? @unique phone String? dob DateTime? gender String? guardian String? parentPhone String? address String? classId String? class Class? @relation(fields:[classId],references:[id]) userId String? @unique user User? @relation(fields:[userId],references:[id]) results Result[] fees Fee[] attendance AttendanceRecord[] assignments AssignmentSubmission[] notifications Notification[] createdAt DateTime @default(now()) }
model Teacher { id String @id @default(cuid()) teacherNumber String @unique fullName String email String? @unique phone String? address String? userId String? @unique user User? @relation(fields:[userId],references:[id]) assignments TeachingAssignment[] timetable Timetable[] createdAt DateTime @default(now()) }
model Class { id String @id @default(cuid()) name String @unique section String? room String? students Student[] assignments TeachingAssignment[] timetable Timetable[] exams Exam[] assignmentsMade Assignment[] attendanceRecords AttendanceRecord[] results Result[] }
model Subject { id String @id @default(cuid()) code String @unique name String assignments TeachingAssignment[] results Result[] timetable Timetable[] exams Exam[] assignmentsMade Assignment[] }
model TeachingAssignment { id String @id @default(cuid()) teacherId String teacher Teacher @relation(fields:[teacherId],references:[id]) classId String class Class @relation(fields:[classId],references:[id]) subjectId String subject Subject @relation(fields:[subjectId],references:[id]) @@unique([teacherId,classId,subjectId]) }
model AttendanceRecord { id String @id @default(cuid()) date DateTime @db.Date studentId String student Student @relation(fields:[studentId],references:[id]) classId String class Class @relation(fields:[classId],references:[id]) status AttendanceStatus markedById String? @@unique([date,studentId]) }
model Result { id String @id @default(cuid()) examName String marks Float maxMarks Float @default(100) date DateTime @db.Date studentId String student Student @relation(fields:[studentId],references:[id]) classId String class Class @relation(fields:[classId],references:[id]) subjectId String subject Subject @relation(fields:[subjectId],references:[id]) recordedById String? }
model Fee { id String @id @default(cuid()) term String total Float paid Float @default(0) lastPayment DateTime? note String? studentId String student Student @relation(fields:[studentId],references:[id]) }
model Timetable { id String @id @default(cuid()) day String startTime String endTime String? classId String class Class @relation(fields:[classId],references:[id]) subjectId String subject Subject @relation(fields:[subjectId],references:[id]) teacherId String teacher Teacher @relation(fields:[teacherId],references:[id]) }
model Assignment { id String @id @default(cuid()) title String description String? dueDate DateTime classId String class Class @relation(fields:[classId],references:[id]) subjectId String subject Subject @relation(fields:[subjectId],references:[id]) teacherId String createdAt DateTime @default(now()) submissions AssignmentSubmission[] }
model AssignmentSubmission { id String @id @default(cuid()) assignmentId String assignment Assignment @relation(fields:[assignmentId],references:[id]) studentId String student Student @relation(fields:[studentId],references:[id]) content String? submittedAt DateTime @default(now()) @@unique([assignmentId,studentId]) }
model Exam { id String @id @default(cuid()) title String scheduledAt DateTime classId String class Class @relation(fields:[classId],references:[id]) subjectId String subject Subject @relation(fields:[subjectId],references:[id]) teacherId String }
model Announcement { id String @id @default(cuid()) title String message String publishedAt DateTime @default(now()) createdById String }
model Notification { id String @id @default(cuid()) title String body String read Boolean @default(false) studentId String student Student @relation(fields:[studentId],references:[id]) createdAt DateTime @default(now()) }
model PasswordResetToken { id String @id @default(cuid()) tokenHash String @unique expiresAt DateTime userId String user User @relation(fields:[userId],references:[id]) createdAt DateTime @default(now()) }
